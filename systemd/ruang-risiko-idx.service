[Unit]
Description=Ruang Risiko IDX Autonomous Research Terminal
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ruang-risiko-idx
ExecStart=/opt/ruang-risiko-idx/.venv/bin/streamlit run app/app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
