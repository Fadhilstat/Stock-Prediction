# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Local market data
data/raw/
data/processed/
data/snapshots/
data/audit/

# Keep empty directory structure when needed
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/snapshots/.gitkeep
!data/audit/.gitkeep

# Databases and generated datasets
*.parquet
*.duckdb
*.db
*.sqlite
*.sqlite3

# The public bundle is intentionally versioned after offline validation
!deployment/*.parquet

# Models and generated artifacts
artifacts/
models/
*.joblib
*.pkl
*.pt
*.pth
*.safetensors
*.onnx

# Logs
*.log
logs/

# Jupyter
.ipynb_checkpoints/

# IDE and editor settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
# Generated Python package metadata
*.egg-info/

# Generated risk snapshot outputs
reports/risk/*.parquet
reports/risk/*.json

# Generated machine learning outputs
data/processed/ml_features.parquet
reports/ml/*.parquet
reports/foundation/kronos/**/*.parquet
reports/foundation/granite/rolling_backtest_pilot/
reports/foundation/granite/rolling_backtest_full_252/

# Generated direction snapshot outputs
reports/ml/latest_direction_snapshot.json

# Generated daily intelligence output
reports/intelligence/*.json
